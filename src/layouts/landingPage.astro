---
import '../styles/global.css';
import '../styles/menu.css';
import "../styles/rose-velvet-theme.css";
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import type { Locales, LocaleProps } from '../pages/index.astro';

type Props = {
  title: string;
  buttonLabels: LocaleProps;
  buttonUrls: LocaleProps;
}

const { title, buttonLabels, buttonUrls } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
---
<html lang={locale}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#030712" />
        <link rel="icon" href="/astro-cocktail-menu/favicon.ico" />
        <Font cssVariable="--font-bona-nova" />
        <title>{title}</title>
        <ClientRouter />
    </head>
    <body>
        <main class="landing-content">
            <h1>{title}</h1>
            <nav class="landing-links" aria-label="Language selection">
                {Object.entries(buttonLabels).map(([key, value]) => (
                    <a href={buttonUrls[key as Locales]} class:list={['landing-link', `lang-${key}`]}>{value}</a>
                ))}
            </nav>
        </main>
    </body>
</html>